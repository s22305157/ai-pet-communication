# Copy to .env.<firebase-project-id>; never put API keys here.
AI_ENABLED=false
AI_ALL_AUTHENTICATED=false
# All tiers share this model. Empty disables AI; legacy tier models are ignored.
OPENAI_MODEL=gpt-5.6-luna
# All tiers reuse the Luna credential in Secret Manager: OPENAI_API_KEY_PRO.
# Comma-separated Firebase Auth UIDs. Empty = deny all; no wildcard.
AI_ALLOWED_UIDS=
