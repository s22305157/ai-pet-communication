# Copy to .env.<firebase-project-id>; never put API keys here.
AI_ENABLED=false
AI_ALL_AUTHENTICATED=false
OPENAI_MODEL_FREE=gpt-5.4-mini
# An explicitly empty model disables that tier. No cross-tier fallback.
OPENAI_MODEL_PLUS=gpt-5.4-mini
OPENAI_MODEL_PRO=gpt-5.6-luna
# Comma-separated Firebase Auth UIDs. Empty = deny all; no wildcard.
AI_ALLOWED_UIDS=
