rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function notDeleted() {
      return signedIn() && !exists(/databases/$(database)/documents/_deletedUsers/$(request.auth.uid));
    }
    function activeAccount() {
      return notDeleted() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function paidMembership() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let entitlements = user.get('membershipEntitlements', {});
      return user.get('subscriptionVerified', false) == true &&
        (entitlements.get('plus', request.time) > request.time ||
         entitlements.get('pro', request.time) > request.time);
    }
    function text(value, limit) { return value is string && value.size() <= limit; }
    function optionalText(value, limit) { return value == null || text(value, limit); }
    function validUser(data) {
      return text(data.displayName, 200) && optionalText(data.photoUrl, 4096)
        && data.hasCompletedOnboarding is bool && data.lastLoginAt is timestamp
        && (!('onboardingAnswers' in data) || data.onboardingAnswers is map);
    }
    match /users/{userId} {
      match /pilotNotifications/{id} { allow read, write: if false; }
      match /communityBlocks/{id} { allow read, write: if false; }
      match /journalPets/{journalPetId} {
        // Source revisions must be checked on every review read.
        match /weeklyReviews/{week} { allow read, write: if false; }
        function journalOwner() {
          return activeAccount() && request.auth.uid == userId;
        }
        function journalAlive(data) {
          return data.get('deletedAt', null) == null && (data.get('linkedPetId', null) == null ||
            !exists(/databases/$(database)/documents/petTombstones/$(data.linkedPetId)));
        }
        allow get: if journalOwner() && journalAlive(resource.data);
        allow list, write: if false;
        match /entries/{entryId} {
          allow get: if journalOwner() && resource.data.get('deletedAt', null) == null
            && journalAlive(get(/databases/$(database)/documents/users/$(userId)/journalPets/$(journalPetId)).data);
          allow list, write: if false;
        }
      }
      match /journalMedia/{mediaId} {
        allow read, write: if false;
      }
      match /planetCards/{cardId} {
        allow read: if activeAccount() && request.auth.uid == userId;
        allow write: if false;
      }
      allow read: if notDeleted() && request.auth.uid == userId;
      allow create: if notDeleted() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'photoUrl', 'points', 'membershipTier', 'hasCompletedOnboarding', 'createdAt', 'lastLoginAt'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoUrl', 'points', 'membershipTier', 'hasCompletedOnboarding', 'createdAt', 'lastLoginAt'])
        && request.resource.data.uid == userId && text(request.resource.data.email, 320)
        && request.resource.data.points == 1 && request.resource.data.membershipTier == 'free'
        && request.resource.data.hasCompletedOnboarding == false
        && request.resource.data.createdAt is timestamp && validUser(request.resource.data);
      allow update: if notDeleted() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoUrl', 'hasCompletedOnboarding', 'onboardingAnswers', 'lastLoginAt'])
        && validUser(request.resource.data);
      allow delete: if false;
    }
    match /communityPosts/{postId}/{rest=**} { allow read, write: if false; }
    match /communityReports/{reportId} { allow read, write: if false; }
    function livePet(petId) {
      return !exists(/databases/$(database)/documents/petTombstones/$(petId));
    }
    function validPet(data, petId) {
      return data.keys().hasAll(['pet_id', 'owner_id', 'name', 'species', 'breed', 'gender', 'birthday', 'personality', 'avatar_url', 'color', 'weight', 'updated_at'])
        && data.keys().hasOnly(['pet_id', 'owner_id', 'name', 'species', 'breed', 'gender', 'birthday', 'personality', 'avatar_url', 'color', 'weight', 'created_at', 'updated_at'])
        && data.pet_id == petId && data.owner_id == request.auth.uid
        && text(data.name, 200) && data.name.size() > 0 && text(data.species, 100)
        && text(data.breed, 200) && text(data.gender, 50) && text(data.birthday, 32)
        && text(data.personality, 4000) && text(data.avatar_url, 4096) && text(data.color, 100)
        && data.weight is number && data.weight >= 0 && data.weight <= 10000
        && data.updated_at == request.time;
    }
    match /pets/{petId} {
      allow read: if activeAccount() && (resource == null || resource.data.owner_id == request.auth.uid);
      allow create: if activeAccount() && paidMembership() && livePet(petId) && validPet(request.resource.data, petId)
        && request.resource.data.created_at is timestamp;
      allow update: if activeAccount() && paidMembership() && livePet(petId)
        && resource.data.owner_id == request.auth.uid && validPet(request.resource.data, petId)
        && request.resource.data.get('created_at', null) == resource.data.get('created_at', null);
      allow delete: if false;
      match /readings/{readingId} {
        function ownsParent() {
          return activeAccount() && livePet(petId)
            && get(/databases/$(database)/documents/pets/$(petId)).data.owner_id == request.auth.uid;
        }
        function validReading(data) {
          return data.keys().hasAll(['petId', 'title', 'content', 'mood', 'source', 'createdAt', 'updatedAt'])
            && data.keys().hasOnly(['petId', 'title', 'content', 'mood', 'source', 'createdAt', 'updatedAt'])
            && data.petId == petId && text(data.title, 256) && text(data.content, 100000)
            && optionalText(data.mood, 128) && optionalText(data.source, 256)
            && text(data.createdAt, 40) && data.createdAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*')
            && optionalText(data.updatedAt, 40);
        }
        allow read, delete: if ownsParent();
        allow create, update: if ownsParent() && paidMembership() && validReading(request.resource.data);
      }
    }
    match /petTombstones/{petId} {
      allow get: if activeAccount() && (resource == null || resource.data.owner_id == request.auth.uid);
      allow list, create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
