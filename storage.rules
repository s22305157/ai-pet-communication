rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && firestore.exists(/databases/(default)/documents/users/$(uid))
        && !firestore.exists(/databases/(default)/documents/_deletedUsers/$(uid));
    }

    function isValidPetAvatar(fileName) {
      return request.resource.size <= 10 * 1024 * 1024
        && (
          (fileName.matches('^[A-Za-z0-9_-]+[.](jpg|jpeg)$')
            && request.resource.contentType == 'image/jpeg')
          || (fileName.matches('^[A-Za-z0-9_-]+[.]png$')
            && request.resource.contentType == 'image/png')
        );
    }

    function paidMembership(uid) {
      let user = firestore.get(/databases/(default)/documents/users/$(uid)).data;
      let entitlements = user.get('membershipEntitlements', {});
      return user.get('subscriptionVerified', false) == true &&
        (entitlements.get('plus', request.time) > request.time ||
         entitlements.get('pro', request.time) > request.time);
    }

    match /pets/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && paidMembership(uid) && isValidPetAvatar(fileName);
      allow delete: if isOwner(uid);
    }
    // Journal media is served through authenticated Functions. This avoids the
    // two-document cross-service limit and checks current account/pet state.
    match /journalUploads/{allPaths=**} {
      allow read, write: if false;
    }
    match /journalImages/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
